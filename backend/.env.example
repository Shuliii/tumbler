# Copy this file to .env and fill in your key. .env is git-ignored: never commit it.
ANTHROPIC_API_KEY=

# Which Claude model designs the tumblers. Try claude-haiku-5-5 (cheapest) vs claude-opus-5-5 (best).
DESIGN_MODEL=claude-opus-5-5
# How hard the model thinks: low | medium | high. Designing is simple, so low keeps replies fast.
DESIGN_EFFORT=low

PORT=8787

# The shop's WhatsApp number (international format, digits only). Customers get a
# "send your order on WhatsApp" link to it. Leave empty to hide the link.
SHOP_WHATSAPP=

# Where orders and customer photos are stored during development (git-ignored).
DATA_DIR=data
# Customer photos are deleted after this many days.
PHOTO_RETENTION_DAYS=30

# Network address. Default 127.0.0.1 = this machine only, because the admin page
# has no login yet. Only use 0.0.0.0 once staff login exists.
HOST=127.0.0.1
# Behind a reverse proxy / ingress: which proxies to trust for the visitor's IP
# (used by the rate limit). E.g. 1 (one proxy hop) or 10.0.0.0/8. Default: loopback.
TRUST_PROXY=
